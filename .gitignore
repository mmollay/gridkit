.DS_Store
*.log
.env
*.mp3

# Design audit: the embedded canvas is a ~2.5 MB generated file. The .dc.html
# sources next to it are the working files and do belong in the repository.
.design/gridkit-design-audit.html
.playwright-mcp/
# Screenshots and scratch files left in the repo root while auditing.
# .playwright-mcp/ was already here; these were not, and a screenshot
# once shipped inside the Composer package because of it.
# Any PNG dropped in the repo root is a screenshot from an audit run.
# The project's own images live in docs/, which this does not touch.
/*.png
/tableprobe.php
/selprobe.php
/jsprobe.php
# Anything at the repo root whose name starts with an underscore is a
# scratch file from an audit run. No project file is named that way —
# _audit_seam.php and _repro_rowaction.php each reached a commit before
# this line existed, both swept in by `git add -A`.
/_*
.design/verify/snapshots/
.design/verify/hex-inventory.json
.design/verify/offsets.json
.design/verify/token-*.json

# Internal deployment notes — not for the public repository
INTERNAL-DEPLOY.md

# Composer output. GridKit has no PHP dependencies, but `composer install`
# inside a clone still creates this — it is generated, never committed.
/vendor/
composer.lock
