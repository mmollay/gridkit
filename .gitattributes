# ── Composer package contents ────────────────────────────────────────────────
# These paths belong in the repository but are of no use inside vendor/.
# `composer require mmollay/gridkit` should pull the framework, not the demo
# site, its screenshots or the design audit.
# skeleton.php is deliberately NOT excluded: it is the shortest path from a
# fresh `composer require` to a page that renders.
/demo             export-ignore
# The example links a screenshot under docs/, which is excluded too — the copy
# inside vendor/ would carry a broken image. Read it on GitHub, run it from a clone.
/examples         export-ignore
/docs             export-ignore
/.design          export-ignore
/.github          export-ignore
/ci               export-ignore
/index.php        export-ignore
/sitemap.xml      export-ignore
/robots.txt       export-ignore
/favicon.ico      export-ignore
/CONTRIBUTING.md  export-ignore
/CODE_OF_CONDUCT.md export-ignore
/SECURITY.md      export-ignore
/tests            export-ignore
/SPEC.md          export-ignore
/.CLAUDE.md       export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore
# The site's Apache configuration, and it says so in its own first line. It
# sets a cache policy for the whole directory, rewrites /skill, and answers 403
# for /tests, /ci and /.design — paths belonging to whoever's site is serving
# it, not to GridKit. Shipped inside a package, those rules land in somebody
# else's application. index.php, sitemap.xml, robots.txt and favicon.ico were
# excluded for exactly this reason; these two were missed.
/.htaccess        export-ignore
/llms.txt         export-ignore

# CKEditor 5 is bundled for the rich-text field, which is optional. At 1.7 MB it
# would otherwise dominate every install of a framework that advertises zero
# dependencies. It stays in the repository — a git clone and the demo keep
# working — but it is not part of the Composer package. Projects that need the
# rich-text field include CKEditor themselves.
#
# It lives under assets/, not vendor/: vendor/ belongs to Composer, and a
# `composer install` inside a GridKit clone would write into the same directory.
/assets           export-ignore

# ── Line endings ─────────────────────────────────────────────────────────────
* text=auto eol=lf
*.png binary
*.ico binary
