# GridKit — the public site
#
# Cache policy, first, because it was wrong in a way that hid every deployment.
#
# Something server-wide sends `Cache-Control: max-age=2592000` — thirty days —
# on everything, HTML included. It is not in /etc/apache2 anywhere I could find
# it, and it applies to the other sites on this host too. The effect on a site
# that is edited daily is that a returning visitor sees the copy they first
# loaded, for a month. It is why the landing page still showed v1.54.0 in a
# browser while the server had 1.60.1 on disk.
#
# HTML must revalidate. Assets need not: every asset URL carries ?v=<mtime>, so
# a changed file is a changed URL and a year is safe.
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(php|html)$">
        Header always set Cache-Control "no-cache, must-revalidate"
        Header always unset Expires
    </FilesMatch>
    # immutable ONLY for a URL that carries a version stamp. Layout::asset()
    # appends ?v=<mtime>, so a changed file is a changed URL and a year is safe.
    # A bare /js/gridkit.js is a different matter: freezing that for a year
    # means a visitor keeps last year's script and no deployment reaches them.
    # This bit the project's own parity fixture within an hour of the rule
    # landing — it linked the script unstamped and was served a copy from
    # before that morning's fixes, which looked exactly like a real regression.
    <FilesMatch "\.(css|js|png|jpg|jpeg|svg|webp|woff2?)$">
        <If "%{QUERY_STRING} =~ /(^|&)v=/">
            Header always set Cache-Control "public, max-age=31536000, immutable"
        </If>
        <Else>
            Header always set Cache-Control "public, max-age=3600"
        </Else>
        Header always unset Expires
    </FilesMatch>
    # Directory requests resolve to index.php but FilesMatch never sees a name.
    <If "%{REQUEST_URI} =~ m#/$#">
        Header always set Cache-Control "no-cache, must-revalidate"
        Header always unset Expires
    </If>
</IfModule>

#
# Two jobs: give the agent-facing document a short, stable address, and keep
# things out of the document root that have no business being served.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /skill — the whole API in one document, for an AI assistant to read.
    # Served as text/markdown so a fetch gets the source, not a download.
    RewriteRule ^skill/?$ GRIDKIT_SKILL.md [L]
</IfModule>

<Files "GRIDKIT_SKILL.md">
    ForceType text/markdown
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "public, max-age=3600"
</Files>

<Files "llms.txt">
    ForceType text/plain
    Header set Access-Control-Allow-Origin "*"
</Files>

# Partials: included by a page, never a page themselves. Fetching one directly
# does nothing useful — _showcase.php only defines functions — but a partial
# that later holds anything else should not be reachable by guessing its name.
<FilesMatch "^_.*\.php$">
    Require all denied
</FilesMatch>

# Nothing below is part of the site.
<FilesMatch "\.(conf|ini|log|lock|dist)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(composer\.json|composer\.lock|\.gitattributes|\.gitignore)$">
    Require all denied
</FilesMatch>
RedirectMatch 403 ^/(tests|ci|\.git|\.design)/
